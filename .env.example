# URL base de la API del Backend (Railway o Local)
# API_BASE_URL=https://tandea-back-end-production-8546.up.railway.app/api/v1
API_BASE_URL=http://192.168.0.15:3000/api/v1

# Firebase Cloud Messaging (push). Consola de Firebase > Configuración del proyecto > app Android.
# Debe ser el mismo proyecto que FIREBASE_SERVICE_ACCOUNT del backend. Si faltan, no hay push.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=